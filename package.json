{
  "name": "renaissance-verte",
  "productName": "Renaissance Verte",
  "version": "3.0.0",
  "description": "Survie en 3D : saisons, santé, ferme, cuisine, combat, bunkers — Windows, macOS, Linux, Android.",
  "main": "desktop/main.js",
  "author": "ck526438-lgtm",
  "license": "UNLICENSED",
  "homepage": "https://github.com/ck526438-lgtm/renaissance-verte",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --publish never",
    "dist:win": "vite build && electron-builder --win --publish never",
    "dist:mac": "vite build && electron-builder --mac --publish never",
    "dist:linux": "vite build && electron-builder --linux --publish never",
    "android": "vite build && cap sync android",
    "android:apk": "vite build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "io.github.ck526438lgtm.renaissanceverte",
    "productName": "Renaissance Verte",
    "artifactName": "Renaissance-Verte-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**",
      "desktop/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "Renaissance-Verte-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Renaissance Verte"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.adventure-games",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "maintainer": "ck526438-lgtm <ck526438-lgtm@users.noreply.github.com>",
      "synopsis": "Survie en 3D dans une île vivante",
      "syncDesktopName": true
    }
  },
  "desktopName": "renaissance-verte.desktop",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/status-bar": "8.0.4",
    "three": "0.187.0"
  }
}
